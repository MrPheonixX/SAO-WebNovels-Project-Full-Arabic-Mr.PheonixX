# Optional settings for the Node/Netlify server routes only.
# The GitHub Pages site needs NO environment variables: accounts and the admin
# check live in Supabase (see supabase-sao.sql and client/lib/cloud-config.ts).

# Comma-separated origins allowed to call the API cross-origin (default: none).
CORS_ORIGIN=
# Extra PDF sources for /api/proxy-pdf, as "host/path-prefix" entries.
# By default only the MrPheonixX/My-Works-PDF- repo is allowed.
PDF_PROXY_ALLOWED_PREFIXES=
